TOKEN=replace-with-discord-bot-token
# Optional JSON mapping of Discord guild IDs to channel IDs.
# When set, guilds missing from this mapping are skipped.
CHANNEL_IDS={"guild-id-1":"channel-id-1","guild-id-2":"channel-id-2"}
# Legacy single-channel fallback, used only when CHANNEL_IDS is not set.
CHANNEL_ID=replace-with-channel-id
ENABLE_DYNO_LEAVE_FALLBACK=false
DYNO_BOT_ID=155149108183695360
PORT=10000
